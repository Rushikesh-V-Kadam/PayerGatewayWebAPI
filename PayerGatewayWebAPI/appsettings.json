{
  // Comments are allowed in this file (.NET reads appsettings.json with comments).
  // Every address below is a local test address. Search this file for "TODO" before the gateway is installed
  // on another computer or connected to a real payer.

  // TODO: the address this gateway listens on. Change it for each environment.
  "Urls": "http://localhost:5200",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      // ASP.NET writes "An unhandled exception has occurred" for every error answer, also for normal ones such as
      // 404 "not found". The gateway's own ApiExceptionHandler already logs each error with the right level, so
      // that extra line is switched off.
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    // Gateway data (decisions, forms, prior authorization requests):
    // EhrApi   = in the EHR database (through the EHR data API, section "Ehr").
    // InMemory = local testing only: data is lost when the app stops.
    "Provider": "EhrApi",
    // The payer configuration is always read from the EHR data API: GET payers/{insurancePlanId} (table PA_PAYER).
    // How long one payer is kept before it is read again, in minutes:
    "PayerCacheMinutes": 5
  },
  "FhirApi": {
    // TODO: address of the FHIR API (FHIR R4). BaseUrl is also sent to payers (fhirServer), so payers must be
    // able to reach it; InternalBaseUrl is only called by this gateway.
    "BaseUrl": "http://localhost:5100/fhir/r4",
    "InternalBaseUrl": "http://localhost:5100",
    "TimeoutSeconds": 300
  },
  "Ehr": {
    // TODO: address of the EHR team's Web API (the EHR data API). The local value is the mock EHR.
    "BaseUrl": "http://localhost:5090",
    "DataPath": "api/prior-auth-data",
    "TimeoutSeconds": 30
  },
  "Workflow": {
    // TODO: the address payers use to reach this gateway (PAS notifications, CDex Tasks, DTR links).
    "GatewayPublicBaseUrl": "http://localhost:5200",
    // TODO: "provider.example.org" is a placeholder. Use an address that belongs to the provider organization;
    // payers see these two values as the "system" of the request id and of the Bundle id.
    "ClaimIdentifierSystem": "http://provider.example.org/fhir/sid/prior-auth-request-id",
    "BundleIdentifierSystem": "http://provider.example.org/fhir/sid/pas-bundle-id",
    "DtrAppUrl": "",
    "DtrLinkHours": 72,
    "FhirAuthorizationMinutes": 5,
    "ExpeditedDecisionHours": 72,
    "StandardDecisionDays": 7
  }
}
