          "400": {
            "description": "Bad request (any non-2xx is a failure for the caller)."
          },
          "500": {
            "description": "Server error (any non-2xx is a failure for the caller)."
          }
        }
      }
    },
    "/api/prior-auth-data/questionnaire-responses/{id}": {
      "get": {
        "tags": [
          "DTR forms (PA_QUESTIONNAIRE_RESPONSE)"
        ],
        "operationId": "getQuestionnaireResponse",
        "summary": "A8 - One filled-in DTR form",
        "description": "Read by the FHIR API (GET /fhir/r4/QuestionnaireResponse/{id}) when the EHR sends a form id in questionnaireResponseIds. resourceJson must be returned exactly as stored.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "example": "qr-frm-235b7ad69e85"
          }
        ],
        "responses": {
          "200": {
            "description": "The row, or QuestionnaireResponseDetail = null.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuestionnaireResponseDetailResponse"
                },
                "example": {
                  "QuestionnaireResponseDetail": {
                    "id": "qr-frm-235b7ad69e85",
                    "patientId": "pat-1",
                    "orderId": "ord-1-hd",
                    "coverageId": "cov-1",
                    "questionnaireUrl": "http://example.org/fhir/Questionnaire/dialysis-incenter-hd",
                    "status": "completed",
                    "resourceJson": "{\"resourceType\":\"QuestionnaireResponse\",\"id\":\"qr-frm-235b7ad69e85\",\"status\":\"completed\"}",
                    "ehrResponseId": null,
                    "ehrSyncStatus": "PENDING",
                    "lastUpdatedUtc": "2026-10-09T05:20:00Z"
                  },
                  "TOKEN_EXPIRED": "",
                  "ERROR_MESSAGE": ""
                }
              }
            }
          },
          "400": {
            "description": "Bad request (any non-2xx is a failure for the caller)."
          },
          "500": {
            "description": "Server error (any non-2xx is a failure for the caller)."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CdexTaskRow": {
        "type": "object",
        "description": "Row of PA_CDEX_TASK. Primary key (INSURANCE_PLAN_ID, TASK_ID).",
        "required": [
          "insurancePlanId",
          "taskId",
          "requestId",
          "trackingId",
          "taskJson",
          "receivedAt"
        ],
        "properties": {
          "insurancePlanId": {
            "type": "integer",
            "format": "int32",
            "description": "INSURANCE_PLAN_ID NUMBER(10). Payer key, part 1."
          },
          "taskId": {
            "type": "string",
            "maxLength": 100,
            "description": "TASK_ID. The payer's Task id, part 2."
          },
          "requestId": {
            "type": "string",
            "maxLength": 64,
            "description": "REQUEST_ID = PA_PRIOR_AUTH.REQUEST_ID."
          },
          "trackingId": {
            "type": "string",
            "maxLength": 100,
            "description": "TRACKING_ID. Sent back to the payer with the documents."
          },
          "trackingSystem": {
            "type": "string",
            "maxLength": 500,
            "nullable": true,
            "description": "TRACKING_SYSTEM. Sent back unchanged."
          },
          "status": {
            "type": "string",
            "maxLength": 20,
            "nullable": true,
            "description": "STATUS: requested | in-progress | completed | cancelled ..."
          },
          "dueDate": {
            "type": "string",
            "maxLength": 30,
            "nullable": true,
            "description": "DUE_DATE. Date text as the payer sent it (Task.restriction.period.end)."
          },
          "taskJson": {
            "type": "string",
            "description": "TASK_JSON CLOB (IS JSON). The FHIR Task as received; return unchanged."
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time",
            "description": "RECEIVED_AT TIMESTAMP (UTC)."
          }
        }
      },
      "PriorAuthRow": {
        "type": "object",
        "description": "Row of PA_PRIOR_AUTH with the client's property names.",
        "required": [
          "RequestID",
          "InsurancePlanID",
          "PatientID",
          "CoverageID",
          "OrganizationID",
          "Priority",
          "Status",
          "VersionNo",
          "SubmittedAt",
          "UpdatedAt"
        ],
        "properties": {
          "RequestID": {
            "type": "string",
            "description": "Key."
          },
          "InsurancePlanID": {
            "type": "integer",
            "format": "int32"
          },
          "PatientID": {
            "type": "string"
          },
          "CoverageID": {
            "type": "string"
          },
          "MemberID": {
            "type": "string",
            "nullable": true,
            "description": "Required by CDex ($submit-attachment MemberId 1..1)."
          },
          "OrganizationID": {
            "type": "string"
          },
          "OrganizationNPI": {
            "type": "string",
            "nullable": true,
            "description": "CDex OrganizationId and Task search owner. One of OrganizationNPI / PractitionerNPI must be filled for CDex."
          },
          "PractitionerID": {
            "type": "string",
            "nullable": true
          },
          "PractitionerNPI": {
            "type": "string",
            "nullable": true,
            "description": "CDex ProviderId."
          },
          "Priority": {
            "type": "string",
            "enum": [
              "routine",
              "urgent"
            ]
          },
          "Status": {
            "type": "string",
            "enum": [
              "approved",
              "partially-approved",
              "denied",
              "pended",
              "not-required",
              "cancelled",
              "contact-payer",
              "error"
            ]
          },
          "AuthorizationNumber": {
            "type": "string",
            "nullable": true
          },
          "VersionNo": {
            "type": "integer"
          },
          "OrderIDsJSON": {
            "type": "string",
            "nullable": true,
            "description": "JSON text."
          },
          "LineNumbersJSON": {
            "type": "string",
            "nullable": true,
            "description": "JSON text."
          },
          "DecisionJSON": {
            "type": "string",
            "nullable": true,
            "description": "JSON text: the full decision including informationRequests (see InformationRequest)."
          },
          "LastRequestBundle": {
            "type": "string",
            "nullable": true,
            "description": "JSON text; can be several MB."
          },
          "LastResponseBundle": {
            "type": "string",
            "nullable": true,
            "description": "JSON text."
          },
          "SubmittedAt": {
            "type": "string",
            "format": "date-time"
          },
          "UpdatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "InformationRequest": {
        "type": "object",
        "description": "One entry of DecisionJSON.informationRequests (the payer's Task as plain JSON). For reference: it is stored inside the DecisionJSON text.",
        "properties": {
          "trackingId": {
            "type": "string"
          },
          "taskId": {
            "type": "string"
          },
          "dueDate": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string"
          },
          "documentsNeeded": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "loincCode": {
                  "type": "string"
                },
                "display": {
                  "type": "string",
                  "nullable": true
                },
                "lineNumber": {
                  "type": "integer",
                  "nullable": true
                }
              }
            }
          },
          "questionnairesNeeded": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Questionnaire URL"
            }
          }
        }
      },
      "Document": {
        "type": "object",
        "description": "EHR clinical document (description, not the file). Becomes a US Core DocumentReference.",
        "required": [
          "documentId",
          "patientId",
          "typeCode",
          "status"
        ],
        "properties": {
          "documentId": {
            "type": "string",
            "description": "→ DocumentReference.id, identifier.value. Sent in documentIds."
          },
          "patientId": {
            "type": "string",
            "description": "→ subject Patient/{id}."
          },
          "typeCode": {
            "type": "string",
            "description": "LOINC document type, e.g. 11502-2 Laboratory report, 11506-3 Progress note, 18842-5 Discharge summary → type; Attachment.Code."
          },
          "typeCodeSystem": {
            "type": "string",
            "default": "LOINC"
          },
          "typeDisplay": {
            "type": "string",
            "nullable": true
          },
          "category": {
            "type": "string",
            "nullable": true,
            "description": "Empty = clinical-note."
          },
          "title": {
            "type": "string",
            "nullable": true,
            "description": "→ description, attachment.title."
          },
          "createdDateTime": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "→ date, attachment.creation."
          },
          "authorPractitionerId": {
            "type": "string",
            "nullable": true,
            "description": "→ author Practitioner/{id}."
          },
          "organizationId": {
            "type": "string",
            "nullable": true
          },
          "encounterId": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "current",
              "superseded",
              "entered-in-error"
            ]
          },
          "contentType": {
            "type": "string",
            "nullable": true,
            "description": "MIME type: application/pdf, text/plain, image/png ..."
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "contentUrl": {
            "type": "string",
            "nullable": true,
            "description": "Information only."
          }
        }
      },
      "DocumentContent": {
        "type": "object",
        "description": "The file of a document. Becomes a FHIR Binary.",
        "required": [
          "documentId",
          "contentBase64"
        ],
        "properties": {
          "documentId": {
            "type": "string"
          },
          "contentType": {
            "type": "string",
            "nullable": true,
            "description": "Empty = application/octet-stream."
          },
          "contentBase64": {
            "type": "string",
            "format": "byte",
            "description": "The whole file, Base64."
          }
        }
      },
      "QuestionnaireResponseRow": {
        "type": "object",
        "description": "Row of PA_QUESTIONNAIRE_RESPONSE (DTR step).",
        "required": [
          "id",
          "patientId",
          "status",
          "resourceJson",
          "ehrSyncStatus",
