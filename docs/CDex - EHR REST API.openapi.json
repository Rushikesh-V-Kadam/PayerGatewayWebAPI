{
  "openapi": "3.0.4",
  "info": {
    "title": "CDex - EHR REST APIs (provided by the EHR team)",
    "version": "v1",
    "description": "REST APIs the EHR team provides for the CDex step (Da Vinci CDex 2.0.0 / PAS 2.0.1 Task) of the Payer Gateway prior authorization workflow. The Payer Gateway and the FHIR API have no database of their own: they save and read CDex data in the EHR's Oracle database through these APIs.\n\n**Rules**\n- Every answer is HTTP 200 in the client's format: `{ \"<EntityName>\": <row, list or null>, \"TOKEN_EXPIRED\": \"\", \"ERROR_MESSAGE\": \"\" }`. The callers read the one entity property whatever its name.\n- Any text in `TOKEN_EXPIRED` or `ERROR_MESSAGE`, or any non-2xx HTTP status, is a failure.\n- No row: entity = `null` (HTTP 404 is understood too). Empty list: `[]`.\n- Request bodies are the plain row (not wrapped); one property = one column.\n- PUT = insert, or update when the key in the URL exists (Oracle MERGE); safe to repeat; the key in the URL wins.\n- Properties ending in Json / JSON / Bundle are strings holding JSON: store in the CLOB and return unchanged.\n- Timestamps: UTC ISO-8601 with Z. Allow request / response bodies of at least 20 MB.\n- Ids in the URL are URL-encoded by the caller.\n- No authentication is built in yet; use HTTPS.\n\n**Open points to confirm:** entity names of the document APIs (DocumentDetail, DocumentContentDetail, DocumentList are suggestions); whether cdex-tasks should use the client's naming (InsurancePlanID, TaskID, TaskJSON) like prior-auths; values of TOKEN_EXPIRED; largest document size."
  },
  "servers": [
    {
      "url": "{ehrBaseUrl}",
      "variables": {
        "ehrBaseUrl": {
          "default": "https://ehr.example.com",
          "description": "EHR base URL"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "CDex Tasks (PA_CDEX_TASK)",
      "description": "Payer information requests (FHIR Tasks). Called by the Payer Gateway."
    },
    {
      "name": "Prior auth request (PA_PRIOR_AUTH)",
      "description": "Same APIs as the PAS step; CDex reads the member id and NPIs and updates DecisionJSON. Called by the Payer Gateway."
    },
    {
      "name": "Documents",
      "description": "EHR clinical documents. Called by the FHIR API (turned into DocumentReference and Binary)."
    },
    {
      "name": "DTR forms (PA_QUESTIONNAIRE_RESPONSE)",
      "description": "Filled-in DTR forms sent with the attachments. Called by the FHIR API."
    }
  ],
  "paths": {
    "/api/prior-auth-data/cdex-tasks/{insurancePlanId}/{taskId}": {
      "put": {
        "tags": [
          "CDex Tasks (PA_CDEX_TASK)"
        ],
        "operationId": "saveCdexTask",
        "summary": "A1 - Save (insert / update) one payer Task",
        "description": "Called for every Task found at the payer for a pended request, and after the attachments were sent (status completed / in-progress). MERGE on (INSURANCE_PLAN_ID, TASK_ID).",
        "parameters": [
          {
            "name": "insurancePlanId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "example": 1001,
            "description": "Payer key (PA_PAYER.INSURANCE_PLAN_ID)."
          },
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 100
            },
            "example": "5b2c9a7e4d1f4c0e8a36f1d2c3b4a5e6",
            "description": "The payer's Task id (Task.id)."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CdexTaskRow"
              },
              "example": {
                "insurancePlanId": 1001,
                "taskId": "5b2c9a7e4d1f4c0e8a36f1d2c3b4a5e6",
                "requestId": "PA-2026-0102",
                "trackingId": "TRK-3f9a1c2b7d4e5f60",
                "trackingSystem": "http://example.org/cdex/tracking-ids",
                "status": "requested",
                "dueDate": "2026-10-23",
                "taskJson": "{\"resourceType\":\"Task\",\"id\":\"5b2c9a7e4d1f4c0e8a36f1d2c3b4a5e6\",\"status\":\"requested\"}",
                "receivedAt": "2026-10-09T05:31:02Z"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved; CdexTaskDetail = the saved row.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CdexTaskDetailResponse"
                },
                "example": {
                  "CdexTaskDetail": {
                    "insurancePlanId": 1001,
                    "taskId": "5b2c9a7e4d1f4c0e8a36f1d2c3b4a5e6",
                    "requestId": "PA-2026-0102",
                    "trackingId": "TRK-3f9a1c2b7d4e5f60",
                    "trackingSystem": "http://example.org/cdex/tracking-ids",
                    "status": "requested",
                    "dueDate": "2026-10-23",
                    "taskJson": "{\"resourceType\":\"Task\",\"id\":\"5b2c9a7e4d1f4c0e8a36f1d2c3b4a5e6\",\"status\":\"requested\"}",
                    "receivedAt": "2026-10-09T05:31:02Z"
                  },
                  "TOKEN_EXPIRED": "",
                  "ERROR_MESSAGE": ""
                }
              }
            }
          },
          "400": {
            "description": "Bad request (any non-2xx is a failure for the caller)."
          },
          "500": {
            "description": "Server error (any non-2xx is a failure for the caller)."
          }
        }
      }
    },
    "/api/prior-auth-data/cdex-tasks": {
      "get": {
        "tags": [
          "CDex Tasks (PA_CDEX_TASK)"
        ],
        "operationId": "listCdexTasks",
        "summary": "A2 - All Tasks of one prior authorization request",
        "description": "SELECT ... FROM PA_CDEX_TASK WHERE REQUEST_ID = :requestId (index IX_PA_CDEX_TASK_REQUEST).",
        "parameters": [
          {
            "name": "requestId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "example": "PA-2026-0102"
          }
        ],
        "responses": {
          "200": {
            "description": "The matching rows ([] when nothing matches).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CdexTaskListResponse"
                },
                "example": {
                  "CdexTaskList": [
                    {
                      "insurancePlanId": 1001,
                      "taskId": "5b2c9a7e4d1f4c0e8a36f1d2c3b4a5e6",
                      "requestId": "PA-2026-0102",
                      "trackingId": "TRK-3f9a1c2b7d4e5f60",
                      "trackingSystem": "http://example.org/cdex/tracking-ids",
                      "status": "requested",
                      "dueDate": "2026-10-23",
                      "taskJson": "{\"resourceType\":\"Task\",\"id\":\"5b2c9a7e4d1f4c0e8a36f1d2c3b4a5e6\",\"status\":\"requested\"}",
                      "receivedAt": "2026-10-09T05:31:02Z"
                    }
                  ],
                  "TOKEN_EXPIRED": "",
                  "ERROR_MESSAGE": ""
                }
              }
            }
          },
          "400": {
            "description": "Bad request (any non-2xx is a failure for the caller)."
          },
          "500": {
            "description": "Server error (any non-2xx is a failure for the caller)."
          }
        }
      }
    },
    "/api/prior-auth-data/prior-auths/{requestId}": {
      "get": {
        "tags": [
          "Prior auth request (PA_PRIOR_AUTH)"
        ],
        "operationId": "getPriorAuth",
        "summary": "A3 - Read one prior authorization request",
        "description": "CDex uses: InsurancePlanID (payer), Status (Tasks are searched only while 'pended'), MemberID ($submit-attachment MemberId, required), OrganizationNPI (OrganizationId and Task search owner), PractitionerNPI (ProviderId), DecisionJSON (informationRequests). Property names: any letter case is accepted.",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "example": "PA-2026-0102"
          }
        ],
        "responses": {
          "200": {
            "description": "The row, or PriorAuthDetail = null when there is no such request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PriorAuthDetailResponse"
                },
                "example": {
                  "PriorAuthDetail": {
                    "RequestID": "PA-2026-0102",
                    "InsurancePlanID": 1001,
                    "PatientID": "pat-1",
                    "CoverageID": "cov-1",
                    "MemberID": "MBR-1001",
                    "OrganizationID": "org-1",
                    "OrganizationNPI": "1999999992",
                    "PractitionerID": "prac-1",
                    "PractitionerNPI": "1111111112",
                    "Priority": "routine",
                    "Status": "pended",
                    "AuthorizationNumber": null,
                    "VersionNo": 1,
                    "OrderIDsJSON": "[\"ord-1-hd\"]",
                    "LineNumbersJSON": "{\"ord-1-hd\":1}",
                    "DecisionJSON": "{\"requestId\":\"PA-2026-0102\",\"overallStatus\":\"pended\",\"lines\":[{\"sequence\":1,\"orderId\":\"ord-1-hd\",\"decision\":\"pended\"}],\"informationRequests\":[{\"trackingId\":\"TRK-3f9a1c2b7d4e5f60\",\"taskId\":\"5b2c9a7e4d1f4c0e8a36f1d2c3b4a5e6\",\"dueDate\":\"2026-10-23\",\"status\":\"requested\",\"documentsNeeded\":[{\"loincCode\":\"11502-2\",\"display\":null,\"lineNumber\":1}],\"questionnairesNeeded\":[]}],\"errors\":[]}",
                    "LastRequestBundle": "{\"resourceType\":\"Bundle\"}",
                    "LastResponseBundle": "{\"resourceType\":\"Bundle\"}",
                    "SubmittedAt": "2026-10-09T05:30:00Z",
                    "UpdatedAt": "2026-10-09T05:31:02Z"
                  },
                  "TOKEN_EXPIRED": "",
                  "ERROR_MESSAGE": ""
                }
              }
            }
          },
          "400": {
            "description": "Bad request (any non-2xx is a failure for the caller)."
          },
          "500": {
            "description": "Server error (any non-2xx is a failure for the caller)."
          }
        }
      }
    },
