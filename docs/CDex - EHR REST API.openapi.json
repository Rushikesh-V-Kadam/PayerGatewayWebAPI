    },
    "/api/documents/{documentId}": {
      "get": {
        "tags": [
          "Documents"
        ],
        "operationId": "getDocument",
        "summary": "A5 - One clinical document (description, not the file)",
        "description": "The FHIR API turns it into a US Core DocumentReference (GET /fhir/r4/DocumentReference/{id}). Payers ask for documents by LOINC type, so typeCode must be filled.",
        "parameters": [
          {
            "name": "documentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "doc-1-labs"
          }
        ],
        "responses": {
          "200": {
            "description": "The document, or DocumentDetail = null (HTTP 404 also understood).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentDetailResponse"
                },
                "example": {
                  "DocumentDetail": {
                    "documentId": "doc-1-labs",
                    "patientId": "pat-1",
                    "typeCode": "11502-2",
                    "typeCodeSystem": "LOINC",
                    "typeDisplay": "Laboratory report",
                    "category": "clinical-note",
                    "title": "Monthly dialysis labs - September 2026",
                    "createdDateTime": "2026-09-22T12:00:00Z",
                    "authorPractitionerId": "prac-1",
                    "organizationId": "org-1",
                    "encounterId": "enc-1",
                    "status": "current",
                    "contentType": "application/pdf",
                    "sizeBytes": 48213,
                    "contentUrl": "/api/documents/doc-1-labs/content"
                  },
                  "TOKEN_EXPIRED": "",
                  "ERROR_MESSAGE": ""
                }
              }
            }
          },
          "400": {
            "description": "Bad request (any non-2xx is a failure for the caller)."
          },
          "500": {
            "description": "Server error (any non-2xx is a failure for the caller)."
          }
        }
      }
    },
    "/api/documents/{documentId}/content": {
      "get": {
        "tags": [
          "Documents"
        ],
        "operationId": "getDocumentContent",
        "summary": "A6 - The file of a document, Base64",
        "description": "The FHIR API turns it into a FHIR Binary (GET /fhir/r4/Binary/{id}). The gateway embeds the file in $submit-attachment, so files of several MB must work.",
        "parameters": [
          {
            "name": "documentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "doc-1-labs"
          }
        ],
        "responses": {
          "200": {
            "description": "The file, or DocumentContentDetail = null.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentContentDetailResponse"
                },
                "example": {
                  "DocumentContentDetail": {
                    "documentId": "doc-1-labs",
                    "contentType": "application/pdf",
                    "contentBase64": "JVBERi0xLjcKJcfsj6IK..."
                  },
                  "TOKEN_EXPIRED": "",
                  "ERROR_MESSAGE": ""
                }
              }
            }
          },
          "400": {
            "description": "Bad request (any non-2xx is a failure for the caller)."
          },
          "500": {
            "description": "Server error (any non-2xx is a failure for the caller)."
          }
        }
      }
    },
    "/api/patients/{patientId}/documents": {
